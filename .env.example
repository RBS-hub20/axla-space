# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service role key (Project Settings -> API -> service_role). SERVER-ONLY —
# never expose this to the browser. Used by /api/admin/* routes to read the
# waitlist with row-level security bypassed.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Password for /admin/login. Set a strong, unique value in your real
# environment (Vercel), and never commit the actual value to git — this file
# only documents which variables are needed.
ADMIN_PASSWORD="choose-a-strong-admin-password"

# OpenAI API key for the TaxLaya chat widget (/api/chat, model gpt-4o-mini).
# Get one at https://platform.openai.com/api-keys. SERVER-ONLY — never expose
# this to the browser.
OPENAI_API_KEY="your-openai-api-key"

# PostHog analytics (optional). If unset, tracking silently no-ops — the app
# still works fine without it. Get a project key at https://posthog.com.
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-project-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Plunk transactional email (OTP sign-in + welcome email). Get a key at
# https://useplunk.com. SERVER-ONLY — never expose PLUNK_API_KEY to the browser.
PLUNK_API_KEY="your-plunk-api-key"
PLUNK_FROM_EMAIL="hello@axla.space"
PLUNK_FROM_NAME="TaxLaya"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres connection strings for Prisma (OtpToken + User tables — see
# prisma/schema.prisma).
#
# If you're on plain Postgres (not Supabase's pooler), DATABASE_URL alone is
# enough and DIRECT_URL can be the same value.
#
# If you're on SUPABASE, you need BOTH, and they must be different:
# - DATABASE_URL: the pooled connection (port 6543, Transaction mode,
#   `?pgbouncer=true`) — this is what the app uses at runtime. Get it from
#   Project Settings -> Database -> Connection Pooling -> Transaction.
# - DIRECT_URL: same host, port 5432 instead (Session mode, no pgbouncer
#   param) — `prisma migrate`/`db push` need this because PgBouncer's
#   Transaction mode doesn't support the prepared statements Prisma Migrate
#   relies on. Using the pooler host (not the bare `db.<ref>.supabase.co`
#   direct-connection host) here avoids IPv6-only connectivity issues on
#   platforms like Vercel.
#
# Run `npx prisma migrate deploy` (prod) or `npx prisma migrate dev` (local)
# after setting these to create the tables.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign/verify the taxlaya_session JWT (see src/lib/jwt.ts).
# SERVER-ONLY — never expose this to the browser. Set a long random value in
# any real environment; if unset, local dev falls back to a known, insecure
# dev secret and production refuses to start signing tokens at all.
JWT_SECRET="generate-a-long-random-string-for-real-environments"

# For Tony Stark Jarvis voice — get key at elevenlabs.io, voice_id
# pFZP5JQG7iQjIQuC4Bku or a custom Jarvis clone. SERVER-ONLY on purpose (not
# NEXT_PUBLIC_*) — this key is billed per character, so it must never ship
# to the browser bundle where anyone could read it out and run up usage.
# The admin Jarvis bar calls /api/admin/jarvis/speak, which is the only
# thing that ever touches this key; unset, it silently falls back to the
# browser's own window.speechSynthesis. See src/lib/voice/elevenlabs.ts.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="pFZP5JQG7iQjIQuC4Bku"
