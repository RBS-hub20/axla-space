# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service role key (Project Settings -> API -> service_role). SERVER-ONLY —
# never expose this to the browser. Used by /api/admin/* routes to read the
# waitlist with row-level security bypassed.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Password for /admin/login. Set a strong, unique value in your real
# environment (Vercel), and never commit the actual value to git — this file
# only documents which variables are needed.
ADMIN_PASSWORD="choose-a-strong-admin-password"

# OpenAI API key for the TaxLaya chat widget (/api/chat, model gpt-4o-mini).
# Get one at https://platform.openai.com/api-keys. SERVER-ONLY — never expose
# this to the browser.
OPENAI_API_KEY="your-openai-api-key"

# PostHog analytics (optional). If unset, tracking silently no-ops — the app
# still works fine without it. Get a project key at https://posthog.com.
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-project-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
