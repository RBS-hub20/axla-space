generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}
