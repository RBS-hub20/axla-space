# Vercel
.vercel

# dependencies
/node_modules

# Next.js build output
/.next
/out
.next-stale-*

# @ducanh2912/next-pwa generated service worker (regenerated on every build)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/fallback-*.js

# env files — never commit secrets. Broad `.env*` catches accidental
# duplicate/backup copies too (e.g. ".env 2", ".env 2.local" — a macOS
# "keep both files" style duplicate found untracked on disk 2026-07-24,
# confirmed never committed, deleted). Explicit lines kept below for
# clarity even though the glob already covers them.
.env*
!.env.example
.env
.env.local
.env.*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
.claude/
waitlist-fix
